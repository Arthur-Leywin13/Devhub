generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  creator
  moderator
  admin
}

enum UserStatus {
  active
  suspended
  banned
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  username               String                    @unique @db.VarChar(30)
  name                   String                    @db.VarChar(80)
  email                  String                    @unique @db.VarChar(254)
  passwordHash           String?                   @map("password_hash")
  avatarUrl              String?                   @map("avatar_url")
  bio                    String                    @default("") @db.VarChar(500)
  role                   UserRole                  @default(user)
  status                 UserStatus                @default(active)
  statusReason           String?                   @map("status_reason")
  suspendedUntil         DateTime?                 @map("suspended_until")
  followersCount         Int                       @default(0) @map("followers_count")
  followingCount         Int                       @default(0) @map("following_count")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  projects               Project[]
  following              UserFollow[]              @relation("UserFollowing")
  followers              UserFollow[]              @relation("UserFollowers")
  conversationMemberships ConversationParticipant[]
  sentMessages           Message[]
  articles               Article[]
  posts                  Post[]
  comments               Comment[]
  projectLikes           ProjectLike[]
  articleLikes           ArticleLike[]
  postLikes              PostLike[]
  savedItems             SavedItem[]
  notificationsReceived  Notification[]              @relation("NotificationRecipient")
  notificationsSent      Notification[]              @relation("NotificationActor")
  coursesAuthored        Course[]
  courseProgress         CourseProgress[]
  warningsReceived       UserWarning[]                @relation("WarningRecipient")
  warningsIssued         UserWarning[]                @relation("WarningIssuer")
  reportsFiled           Report[]                     @relation("ReportReporter")
  auditActions            AuditLog[]                   @relation("AuditActor")

  @@index([name])
  @@map("users")
}

model UserFollow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("user_follows")
}

model Conversation {
  id        String                    @id @default(uuid()) @db.Uuid
  directKey String?                   @unique @map("direct_key") @db.VarChar(73)
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")
  participants ConversationParticipant[]
  messages  Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String       @db.VarChar(5000)
  createdAt      DateTime     @default(now()) @map("created_at")
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(120)
  name            String   @db.VarChar(80)
  description     String   @db.VarChar(300)
  longDescription String   @default("") @map("long_description") @db.VarChar(5000)
  image           String   @default("")
  images          String[] @default([])
  video           String?
  files           Json     @default("[]")
  authorId        String   @map("author_id") @db.Uuid
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tech            String[] @default([])
  category        String   @default("Autre") @db.VarChar(80)
  github          String?
  demo            String?
  licence         String   @default("Aucune") @db.VarChar(40)
  allowDownload   Boolean  @default(false) @map("allow_download")
  likesCount      Int      @default(0) @map("likes_count")
  commentsCount   Int      @default(0) @map("comments_count")
  stars           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([category])
  likes               ProjectLike[]

  @@index([createdAt])
  @@map("projects")
}

model ProjectLike {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, createdAt])
  @@map("project_likes")
}

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique @db.VarChar(160)
  title         String        @db.VarChar(180)
  excerpt       String        @db.VarChar(500)
  content       String        @db.Text
  category      String        @db.VarChar(80)
  authorId      String        @map("author_id") @db.Uuid
  image         String?       @db.VarChar(2048)
  readTime      Int           @default(1) @map("read_time")
  likesCount    Int           @default(0) @map("likes_count")
  commentsCount Int           @default(0) @map("comments_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes         ArticleLike[]

  @@index([authorId, createdAt])
  @@index([category, createdAt])
  @@map("articles")
}

model ArticleLike {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId, createdAt])
  @@map("article_likes")
}

model Post {
  id              String     @id @default(uuid()) @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  content         String     @db.VarChar(5000)
  image           String?    @db.VarChar(2048)
  video           String?    @db.VarChar(2048)
  link            Json?
  linkedProjectId String?    @map("linked_project_id") @db.Uuid
  linkedArticleId String?    @map("linked_article_id") @db.Uuid
  likesCount      Int        @default(0) @map("likes_count")
  commentsCount   Int        @default(0) @map("comments_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes           PostLike[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  text       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([authorId, createdAt])
  @@map("comments")
}

model SavedItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@map("saved_items")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  type        String   @db.VarChar(40)
  targetLabel String?  @map("target_label") @db.VarChar(180)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@map("notifications")
}


model Course {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique @db.VarChar(160)
  title         String          @db.VarChar(180)
  description   String          @db.VarChar(1000)
  image         String?         @db.VarChar(2048)
  category      String          @db.VarChar(80)
  level         String          @db.VarChar(40)
  authorId      String          @map("author_id") @db.Uuid
  studentsCount Int             @default(0) @map("students_count")
  published     Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sections      CourseSection[]
  progress      CourseProgress[]
  @@index([authorId, createdAt])
  @@index([category, createdAt])
  @@map("courses")
}

model CourseSection {
  id        String        @id @default(uuid()) @db.Uuid
  courseId  String        @map("course_id") @db.Uuid
  title     String        @db.VarChar(180)
  position  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   CourseLesson[]
  @@index([courseId, position])
  @@map("course_sections")
}

model CourseLesson {
  id          String        @id @default(uuid()) @db.Uuid
  sectionId   String        @map("section_id") @db.Uuid
  title       String        @db.VarChar(180)
  type        String        @default("TEXT") @db.VarChar(20)
  content     String?       @db.Text
  videoUrl    String?       @map("video_url") @db.VarChar(2048)
  durationMin Int?          @map("duration_min")
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  @@index([sectionId, position])
  @@map("course_lessons")
}

model CourseProgress {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  courseId            String   @map("course_id") @db.Uuid
  completedLessonIds  String[] @default([]) @map("completed_lesson_ids")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@index([courseId, updatedAt])
  @@map("course_progress")
}

model Report {
  id          String   @id @default(uuid()) @db.Uuid
  reporterId  String   @map("reporter_id") @db.Uuid
  targetType  String   @map("target_type") @db.VarChar(20)
  targetId    String   @map("target_id") @db.Uuid
  reason      String   @db.VarChar(40)
  details     String?  @db.VarChar(500)
  context     Json?
  snapshot    Json?
  status      String   @default("open") @db.VarChar(20)
  resolution  String?  @db.VarChar(30)
  resolvedBy  String?  @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at")
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  reporter    User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model UserWarning {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  moderatorId    String    @map("moderator_id") @db.Uuid
  reason         String    @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  user           User      @relation("WarningRecipient", fields: [userId], references: [id], onDelete: Cascade)
  moderator      User      @relation("WarningIssuer", fields: [moderatorId], references: [id], onDelete: Restrict)
  @@index([userId, acknowledgedAt, createdAt])
  @@map("user_warnings")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(50)
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetType   String?  @map("target_type") @db.VarChar(30)
  targetId     String?  @map("target_id") @db.Uuid
  reason       String?  @db.VarChar(500)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
