# Copy this file to backend/.env locally. NEVER commit backend/.env.
# Supabase Dashboard > Connect > Session pooler. Copy the exact URI shown there.
# For the first setup, the same Session Pooler URI (port 5432) can be used for all three.
# Replace the password placeholder locally and URL-encode special characters in it.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"
SESSION_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"

# Exact frontend origin, without trailing slash.
FRONTEND_URL="http://localhost:5173"
PORT=4000
NODE_ENV="development"
# Use a long random value; never reuse or publish this secret.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Firebase Authentication (Google). Store the service account JSON as a private secret.
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the complete JSON on one line in your hosting provider's secret settings.
FIREBASE_PROJECT_ID="devhub-95d5c"
FIREBASE_SERVICE_ACCOUNT_JSON=
