# Copy to backend/.env locally. NEVER commit backend/.env.
# Supabase > Project Settings > Database. Use a Prisma-compatible connection URL.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[DB-HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[DB-HOST]:5432/postgres?sslmode=require"
# Use the Supabase Session Pooler connection string for persistent Express sessions.
SESSION_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[SESSION-POOLER-HOST]:5432/postgres?sslmode=require"
FRONTEND_URL="http://localhost:5173"
PORT=4000
NODE_ENV="development"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"